{
  "name": "deepthink-js",
  "version": "2.0.0",
  "description": "SOTA NPM module for agentic processes using local or cloud LLMs.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node tests/runAll.js",
    "test:fast": "node tests/test_dataTypes.js && node tests/test_memory.js && node tests/test_compression.js && node tests/test_consistency.js && node tests/test_toolUse.js && node tests/test_providers.js && node tests/test_sandbox.js && node tests/test_thinkingPatterns.js && node tests/test_evolvedScoring.js && node tests/test_evolvedMutate.js && node tests/test_evolvedThinking.js",
    "test:ts": "npm run build && npm test",
    "evolve": "node scripts/evolve.js",
    "apply-best": "node scripts/applyBest.js",
    "probe": "node scripts/probeGeneralize.js",
    "probe-ood": "node scripts/probeOOD.js",
    "proxy": "node src/proxy.js",
    "mcp": "node src/mcp.js"
  },
  "dependencies": {
    "@babel/parser": "^7.29.2",
    "@iarna/rtf-to-html": "^1.1.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "chart.js": "^4.5.1",
    "@excel.js/exceljs": "0.13.0",
    "pdfkit": "^0.19.1",
    "sharp": "^0.35.3",
    "@mozilla/readability": "^0.6.0",
    "axios": "^1.15.2",
    "cheerio": "^1.2.0",
    "css-tree": "^3.2.1",
    "ejs": "^5.0.2",
    "electron": "^41.5.0",
    "fast-xml-parser": "^5.7.3",
    "fastify": "^5.11.3",
    "impit": "^0.13.1",
    "isolated-vm": "^6.2.0",
    "java-parser": "^3.0.1",
    "jsdom": "^29.1.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "marked": "^18.0.3",
    "ollama": "^0.6.3",
    "papaparse": "^5.5.3",
    "parse5": "^8.0.1",
    "pdf-parse": "^2.4.5",
    "turndown": "^7.2.4",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crazystuffxyz/deepthink-js.git"
  },
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.19.43",
    "@types/p-queue": "^3.1.0",
    "@types/papaparse": "^5.5.2",
    "@types/turndown": "^5.0.6",
    "p-queue": "^8.1.1",
    "typescript": "5.7"
  }
}
